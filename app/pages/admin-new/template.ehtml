import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { createShifts, NewShiftForm, MAX_WEEKS } from "#app/shared/services/shifts";
import { KINDS, KIND_LABELS, ShiftKind, formatDay, zonedMoment } from "#app/shared/lib/format";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Alert } from "@elements/ui/alert";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NumberInput } from "@elements/ui/number-input";
import { DatePicker } from "@elements/ui/date-picker";
import { TimePicker } from "@elements/ui/time-picker";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Checkbox } from "@elements/ui/checkbox";
import { Label } from "@elements/ui/label";

interface FormState {
  values: NewShiftForm;
  repeat: boolean;
  errors: Partial<Record<keyof NewShiftForm, string>>;
  error: string;
  busy: boolean;
}

const DEFAULT_LOCATIONS: Record<ShiftKind, string> = {
  sorting: "Main Warehouse · 41 Oak St",
  packing: "Main Warehouse · 41 Oak St",
  delivery: "Delivery Depot · 9 Mill Rd",
};

function newForm(date: string): FormState {
  return {
    values: {
      kind: "sorting",
      date,
      startTime: "09:00",
      endTime: "12:00",
      location: DEFAULT_LOCATIONS.sorting,
      capacity: 6,
      weeks: 8,
    },
    repeat: false,
    errors: {},
    error: "",
    busy: false,
  };
}

function pickKind(form: FormState, kind: ShiftKind) {
  let wasDefault = Object.values(DEFAULT_LOCATIONS).includes(form.values.location);
  form.values.kind = kind;

  if (wasDefault || !form.values.location.trim()) {
    form.values.location = DEFAULT_LOCATIONS[kind];
  }
}

function preview(form: FormState): string {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(form.values.date)) {
    return "";
  }

  let day = formatDay(zonedMoment(form.values.date, "12:00"));
  let weekday = day.split(",")[0];

  return form.repeat
    ? `Every ${weekday}, ${form.values.weeks} weeks starting ${day}.`
    : `One shift on ${day}.`;
}

function onSubmit(form: FormState) {
  form.busy = true;

  try {
    createShifts({ ...form.values, weeks: form.repeat ? Number(form.values.weeks) : 1 });
    redirect("/admin");
  } catch (err: any) {
    form.busy = false;

    if (err instanceof ValidationError && err.errors) {
      let errors: FormState["errors"] = {};

      for (let [key, messages] of Object.entries(err.errors)) {
        errors[key as keyof NewShiftForm] = (messages as string[])[0];
      }

      form.errors = errors;
      form.error = "";
    } else {
      form.errors = {};
      form.error = err.message;
    }
  }
}

<html lang="en" class="page-admin-new" (userName: string, tomorrow: string, private form: FormState = newForm(tomorrow))>
  <head>
    <title>New shift · Rostergrove coordinator</title>
    <meta name="description" content="Create a volunteer shift.">
  </head>
  <body>
    <Layout active="new" role="coordinator" {userName} width="is-form">
      <div class="stack is-xl">
        <div class="stack is-xs">
          <h1>New shift</h1>
          <p class="lede">One-off, or the same slot every week.</p>
        </div>

        <form onsubmit={() => onSubmit(form)}>
          <Card>
            <CardContent class="stack is-lg">
              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Shift type" reserveError={false}>
                <RadioGroup value={form.values.kind} orientation="horizontal" class="kind-choice"
                            onValueChange={(value) => pickKind(form, value as ShiftKind)}>
                  <Label e:for={kind of KINDS}>
                    <RadioGroupItem value={kind} />
                    {KIND_LABELS[kind]}
                  </Label>
                </RadioGroup>
              </Field>

              <div class="fields">
                <Field label="Date" error={form.errors.date ?? ""} class="is-full">
                  <DatePicker value={form.values.date} min={tomorrow} required block />
                </Field>

                <Field label="Starts" error={form.errors.startTime ?? ""}>
                  <TimePicker value={form.values.startTime} step={900} required block />
                </Field>

                <Field label="Ends" error={form.errors.endTime ?? ""}>
                  <TimePicker value={form.values.endTime} step={900} required block />
                </Field>

                <Field label="Location" error={form.errors.location ?? ""} class="is-full">
                  <Input value={form.values.location} required />
                </Field>

                <Field label="Volunteers needed" error={form.errors.capacity ?? ""}>
                  <NumberInput value={form.values.capacity} min={1} max={100} required />
                </Field>
              </div>

              <div class="repeat">
                <Label>
                  <Checkbox checked={form.repeat} />
                  Repeat weekly
                </Label>

                <div e:if={form.repeat} class="row">
                  <span>For</span>
                  <NumberInput value={form.values.weeks} min={2} max={MAX_WEEKS} buttons="end" class="weeks"
                               invalid={!!form.errors.weeks} attrs={{ "aria-label": "Number of weeks" }} />
                  <span>weeks</span>
                </div>
                <p e:if={form.errors.weeks} class="error">{form.errors.weeks}</p>
                <p class="preview">{preview(form)}</p>
              </div>
            </CardContent>

            <CardFooter>
              <Button href="/admin" variant="ghost">Cancel</Button>
              <Button type="submit" variant="primary" loading={form.busy}>
                {form.repeat ? `Create ${form.values.weeks} shifts` : "Create shift"}
              </Button>
            </CardFooter>
          </Card>
        </form>
      </div>
    </Layout>
  </body>
</html>
