import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import { signup, MIN_PASSWORD, SignupForm } from "#app/shared/services/auth";
import { AuthShell } from "#app/shared/templates/auth-shell";
import { Button } from "@elements/ui/button";
import { Alert } from "@elements/ui/alert";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface FormState {
  values: SignupForm;
  errors: Partial<Record<keyof SignupForm, string>>;
  error: string;
  busy: boolean;
}

function onSubmit(form: FormState) {
  form.busy = true;

  try {
    signup(form.values);
    form.errors = {};
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.busy = false;

    if (err instanceof ValidationError && err.errors) {
      let errors: FormState["errors"] = {};

      for (let [key, messages] of Object.entries(err.errors)) {
        errors[key as keyof SignupForm] = (messages as string[])[0];
      }

      form.errors = errors;
      form.error = "";
    } else {
      form.error = err.message;
    }
  }
}

<html lang="en" class="page-signup" (
  private form: FormState = {
    values: { name: "", email: "", phone: "", password: "" },
    errors: {},
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Sign up · Rostergrove</title>
    <meta name="description" content="Sign up to volunteer at the Grove Street Food Bank.">
  </head>
  <body>
    <AuthShell title="Sign up to volunteer" lede="It takes a minute. Then pick any shift with a spot open.">
      <form class="stack" onsubmit={() => onSubmit(form)}>
        <Alert e:if={form.error} variant="danger" description={form.error} />

        <Field label="Full name" error={form.errors.name ?? ""}>
          <Input name="name" value={form.values.name} required attrs={{ autocomplete: "name" }} />
        </Field>

        <Field label="Email" error={form.errors.email ?? ""}>
          <Input type="email" name="email" value={form.values.email} placeholder="you@example.org" required
                 attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
        </Field>

        <Field label="Phone" description="So the coordinator can reach you on the day." error={form.errors.phone ?? ""}>
          <Input type="tel" name="phone" value={form.values.phone} placeholder="(312) 555-0142" required
                 attrs={{ autocomplete: "tel" }} />
        </Field>

        <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`} error={form.errors.password ?? ""}>
          <Input type="password" name="password" value={form.values.password} required
                 attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
        </Field>

        <Button type="submit" variant="primary" block loading={form.busy}>Create account</Button>

        <p class="hint">Already volunteering? <a href="/signin">Sign in</a></p>
      </form>
    </AuthShell>
  </body>
</html>
