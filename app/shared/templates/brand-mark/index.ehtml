import "./style.css";

<BrandMark (href: string = "/", size: number = 28)>
  <a class="brand-mark" {href}>
    <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <rect width="32" height="32" rx="8" fill="currentColor"/>
      <path d="M16 25V14" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M16 16c0-4.4 3-7 7.5-7 0 4.4-3 7-7.5 7Z" fill="#fff"/>
      <path d="M16 19.5c0-3.6-2.5-5.8-6.3-5.8 0 3.6 2.5 5.8 6.3 5.8Z" fill="#fff" opacity="0.8"/>
    </svg>
    <span>Rostergrove</span>
  </a>
</BrandMark>
