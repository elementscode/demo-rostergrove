import "./style.css";
import { Badge, BadgeVariant } from "@elements/ui/badge";
import { ShiftKind, KIND_LABELS } from "#app/shared/lib/format";
import { ShiftCounts, spotsLabel } from "#app/shared/lib/roster";

const KIND_INTENT: Record<ShiftKind, BadgeVariant> = {
  sorting: "info",
  packing: "success",
  delivery: "warning",
};

<KindPill (kind: ShiftKind)>
  <Badge variant={KIND_INTENT[kind]} dot>{KIND_LABELS[kind]}</Badge>
</KindPill>

<Spots (counts: ShiftCounts, capacity: number, short: boolean = false, done: boolean = false)>
  <div class={["spots", short && counts.left > 0 && "is-short", counts.left === 0 && "is-full"]}>
    <span class="spots-label">{done ? `${counts.confirmed} of ${capacity} filled` : spotsLabel(counts)}</span>
    <span class="spots-bar" aria-hidden="true">
      <span e:for={i of Array.from({ length: capacity }, (_, n) => n)} class={[i < counts.confirmed && "is-filled"]}></span>
    </span>
  </div>
</Spots>
